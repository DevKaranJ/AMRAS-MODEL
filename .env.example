# ============================================================
# AMRAS — Environment Variable Reference
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# NEVER commit .env to version control — it is in .gitignore.
# ============================================================

# ─── Security ────────────────────────────────────────────────
# Required. Generate a strong secret with:
#   openssl rand -hex 32
# All API requests must include the header:  X-API-Key: <value>
AMRAS_API_KEY=change-me-to-a-strong-random-secret

# Comma-separated list of allowed CORS origins.
# Use "*" only for local development; set explicit URLs in production.
AMRAS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Database ────────────────────────────────────────────────
# Nested settings use the DB__ prefix (env_nested_delimiter="__").
#
# SQLite (default for local dev — do NOT use in production):
DB__URL=sqlite+aiosqlite:///./dev.db

# PostgreSQL (recommended for production):
# DB__URL=postgresql+asyncpg://user:password@localhost:5432/amras
DB__POOL_SIZE=5
DB__MAX_OVERFLOW=10
DB__ECHO=false

# ─── AI Provider ─────────────────────────────────────────────
# "local" uses the built-in MockAIProvider (no external calls).
# Switch to "openai", "anthropic", etc. when ready.
AI__PROVIDER=local
AI__API_KEY=
AI__MODEL=llama3
AI__BASE_URL=

# ─── Storage ─────────────────────────────────────────────────
# Absolute path to the directory where AMRAS stores manga, renders, etc.
# Defaults to ./storage relative to the project root.
# STORAGE__BASE_DIR=/absolute/path/to/storage

# ─── Video ───────────────────────────────────────────────────
# VIDEO__FFMPEG_PATH=ffmpeg
# VIDEO__FFPROBE_PATH=ffprobe
# VIDEO__RESOLUTION=1920x1080
# VIDEO__FPS=30

# ─── OCR ─────────────────────────────────────────────────────
# OCR__ENGINE=tesseract
# OCR__TESSERACT_PATH=tesseract
# OCR__LANGUAGE=eng

# ─── GPU ─────────────────────────────────────────────────────
# Set GPU__ENABLED=false if no CUDA GPU is available (e.g. CI, CPU-only machines).
# GPU__ENABLED=false
# GPU__DEVICE=cuda
# GPU__MEMORY_FRACTION=0.8

# ─── Logging ─────────────────────────────────────────────────
# LOG__LEVEL=INFO
# LOG__FORMAT=json          # "json" for production, "console" for development
# LOG__FILE=                # Leave blank to log to stdout only
# LOG__ROTATION=10 MB

# ─── Debug ───────────────────────────────────────────────────
# Enable only in local development. Exposes /vision/debug/* endpoints.
# DEBUG=false
